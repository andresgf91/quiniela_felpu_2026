generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum ResultSource {
  API
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  pinHash      String
  email        String?
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  soulTeamId   String?
  soulTeam     Team?    @relation(fields: [soulTeamId], references: [id])
  predictions  Prediction[]
  bracketPicks BracketPick[]
  resets       QuinielaReset[]
  activityLogs ActivityLog[]
  createdAt    DateTime @default(now())
}

model Team {
  id        String  @id
  nameEs    String
  nameEn    String
  flagEmoji String
  groupCode String?
  soulUsers User[]
}

model Match {
  id                  Int          @id
  externalId          Int?         @unique
  stage               Stage
  groupCode           String?
  kickoffUtc          DateTime
  venue               String
  city                String
  homeSlot            String
  awaySlot            String
  homeTeamId          String?
  awayTeamId          String?
  homeScore           Int?
  awayScore           Int?
  penaltyWinnerTeamId String?
  status              MatchStatus  @default(SCHEDULED)
  resultSource        ResultSource?
  predictions         Prediction[]
}

model Prediction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId         Int
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeScore       Int
  awayScore       Int
  advancingTeamId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  pointsAwarded   Int?

  @@unique([userId, matchId])
}

model BracketPick {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot   String
  teamId String

  @@unique([userId, slot])
}

model QuinielaReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())
}

model AuditPrediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   Int
  homeScore Int
  awayScore Int
  createdAt DateTime @default(now())
}

model AppConfig {
  id    String @id @default("singleton")
  value String
}
